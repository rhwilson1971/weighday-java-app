<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/AuthFragment">

    <fragment
        android:id="@+id/AuthFragment"
        android:name="net.cynreub.weighday.ui.fragments.AuthFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_auth">
        <action
            android:id="@+id/action_Auth_to_WeightTracker"
            app:destination="@id/WeightTrackerFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/WeightTrackerFragment"
        android:name="net.cynreub.weighday.ui.fragments.WeightTrackerFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_weight_tracker">
        <action
            android:id="@+id/action_Tracker_to_AddWeight"
            app:destination="@id/AddWeightFragment" />
        <action
            android:id="@+id/action_Tracker_to_History"
            app:destination="@id/WeightHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/AddWeightFragment"
        android:name="net.cynreub.weighday.ui.fragments.AddWeightFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_add_weight" />

    <fragment
        android:id="@+id/WeightHistoryFragment"
        android:name="net.cynreub.weighday.ui.fragments.WeightHistoryFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_weight_history" />
</navigation>
